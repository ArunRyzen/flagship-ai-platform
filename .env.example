# Copy to `.env`. All optional — the platform runs fully offline without keys.

# ── Live mode, the easy way: ONE free Gemini key powers everything ──────────────
# Get a key at https://aistudio.google.com/apikey — it enables BOTH the live agent
# policy (gemini-2.5-flash tool-use) and real semantic embeddings (gemini-embedding-001).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Agent policy selector: "gemini" (default) or "anthropic"; no matching key → offline heuristic.
POLICY=gemini
MAX_TOKENS=1024

# ── Alternative providers (only used when GEMINI_API_KEY is not set) ────────────
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Retrieval / agent / gate ─────────────────────────────────────────────────────
TOP_K=4
CANDIDATE_K=12
MAX_STEPS=6
EVAL_THRESHOLD=0.75

# ── Serving ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_S=60

# ── Learning aid ─────────────────────────────────────────────────────────────────
# Set to 1 to print every AI request/response (agent policy calls, embeddings — offline
# fakes included) as readable blocks on stderr. Great for watching the pipeline think.
# Works right here in `.env` — no exporting needed — but a real environment variable
# named LLM_DEBUG always wins when set (so `LLM_DEBUG=0` on the CLI force-disables this).
LLM_DEBUG=
