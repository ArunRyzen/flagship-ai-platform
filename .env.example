# Copy to `.env`. All optional — the platform runs fully offline without keys.

# Semantic embeddings (else an offline hashing embedder is used)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Real agent tool-use (else the offline heuristic policy)
POLICY=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
MAX_TOKENS=1024

# Retrieval / agent / gate
TOP_K=4
CANDIDATE_K=12
MAX_STEPS=6
EVAL_THRESHOLD=0.75

# Serving
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_S=60
